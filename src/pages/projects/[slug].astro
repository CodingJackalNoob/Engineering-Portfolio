---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import ResponsiveMediaImage from '../../components/ResponsiveMediaImage.astro';
import { render } from 'astro:content';
import { getPublicProjects } from '../../lib/cms/public-content';
import { getGeneratedMediaAssignments } from '../../lib/cms/generated-settings';
import { getMediaFieldAssignments, type PublicMediaAssignment } from '../../lib/cms/media';
import '../../styles/global.css';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug ?? project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const formattedDate = project.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const mediaAssignments = await getGeneratedMediaAssignments();
const projectCover = project.data.cmsId ? getMediaFieldAssignments(mediaAssignments, 'project', project.data.cmsId, 'cover')[0] : undefined;
const assignedGallery = project.data.cmsId ? getMediaFieldAssignments(mediaAssignments, 'project', project.data.cmsId, 'gallery') : [];
const projectGallery = assignedGallery.length ? assignedGallery : project.data.images.map((image) => ({ mediaId: image.src, alt: image.alt, caption: image.caption, media: { url: image.src } }));
---

<BaseLayout title={`${project.data.title} — Jainavaneeth Kumarashankar`} description={project.data.description} image={project.data.coverImage}>
  <Header />
  <main id="main-content" class="wrap">
    <article>
      <header class="detail-hero">
        <div class="eyebrow">// {project.data.category} / case study</div>
        <h1>{project.data.title}</h1>
        <p>{project.data.overview ?? project.data.description}</p>
        <div class="article-meta"><span class:list={['status', project.data.status.toLowerCase().replace(' ', '-')] }>{project.data.status}</span><time datetime={project.data.date.toISOString()}>{formattedDate}</time>{project.data.updatedDate && <span>Updated {project.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>}</div>
        <div class="tags">{project.data.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
        <div class="cover">
          {projectCover ? <button class="cover-image-button" type="button" data-gallery-open data-image-src={projectCover.media.url} data-image-alt={projectCover.alt || `${project.data.title} project cover`} aria-label={`Expand ${project.data.title} cover image`}><ResponsiveMediaImage assignment={projectCover} alt={projectCover.alt || `${project.data.title} project cover`} loading="eager" fetchpriority="high" sizes="(max-width: 760px) 100vw, 1180px" /></button> : project.data.coverImage ? <button class="cover-image-button" type="button" data-gallery-open data-image-src={project.data.coverImage} data-image-alt={project.data.coverAlt ?? `${project.data.title} project cover`} aria-label={`Expand ${project.data.title} cover image`}><img src={project.data.coverImage} alt={project.data.coverAlt ?? `${project.data.title} project cover`} fetchpriority="high" /></button> : <div class="media-fallback" aria-hidden="true">PROJECT RENDER / DOCUMENTATION IN PROGRESS</div>}
        </div>
      </header>
      <div class="detail-layout">
        <div class="article">
          <Content />
          {project.data.videoEmbed && <div class="video-embed"><iframe src={project.data.videoEmbed} title={`${project.data.title} video`} loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>}
          {project.data.designProcess && <section class="project-detail-section"><h2>Design process</h2><p>{project.data.designProcess}</p></section>}
          {project.data.hardware && <section class="project-detail-section"><h2>Hardware</h2><p>{project.data.hardware}</p></section>}
          {project.data.software && <section class="project-detail-section"><h2>Software</h2><p>{project.data.software}</p></section>}
          {project.data.progress && <section class="project-detail-section"><h2>Current progress</h2><p>{project.data.progress}</p></section>}
          {project.data.challenges && <section class="project-detail-section"><h2>Challenges and solutions</h2><p>{project.data.challenges}</p></section>}
          {project.data.futureImprovements && <section class="project-detail-section"><h2>Future improvements</h2><p>{project.data.futureImprovements}</p></section>}
        </div>
        <aside class="detail-aside" aria-label="Project reference">
          {toc.length > 0 && <nav class="toc" aria-label="On this page"><strong class="eyebrow">On this page</strong><ul>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
          <div class="aside-panel"><h2>Project record</h2><dl><dt>Category</dt><dd>{project.data.category}</dd><dt>Status</dt><dd>{project.data.status}</dd><dt>Started</dt><dd>{(project.data.startDate ?? project.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</dd>{project.data.completionDate && <><dt>Completed</dt><dd>{project.data.completionDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</dd></>}</dl></div>
          <div class="aside-panel"><h2>Tools &amp; technologies</h2><div class="tags">{project.data.technologies.map((technology) => <span class="tag">{technology}</span>)}</div></div>
          {(project.data.links.github || project.data.links.documentation || project.data.links.video || project.data.links.external) && <div class="aside-panel"><h2>Resources</h2><div class="resource-links">
            {project.data.links.github && <a href={project.data.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
            {project.data.links.documentation && <a href={project.data.links.documentation} target="_blank" rel="noopener noreferrer">Reference documentation ↗</a>}
            {project.data.links.video && <a href={project.data.links.video} target="_blank" rel="noopener noreferrer">Video ↗</a>}
            {project.data.links.external && <a href={project.data.links.external} target="_blank" rel="noopener noreferrer">External resource ↗</a>}
          </div></div>}
        </aside>
      </div>
    </article>
    {projectGallery.length > 0 && <section class="detail-gallery"><div class="sec-head"><h2>Build documentation</h2><span class="sheet-no">PROJECT MEDIA</span></div><div class="grid">{projectGallery.map((image, index) => <figure class="card gallery-card" style="padding:12px"><button class="gallery-image-button" type="button" data-gallery-open data-image-src={image.media.url} data-image-alt={image.alt ?? ''} data-image-caption={image.caption ?? ''} aria-label={`Expand project image ${index + 1}: ${image.alt || project.data.title}`}>
      {'ownerType' in image ? <ResponsiveMediaImage assignment={image as PublicMediaAssignment} loading="lazy" sizes="(max-width: 760px) 100vw, 560px" /> : <img src={image.media.url} alt={image.alt ?? ''} loading="lazy" />}
      <span class="gallery-expand-hint" aria-hidden="true">VIEW IMAGE ↗</span></button>{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}</div></section>}
  </main>
  <ImageLightbox title={`${project.data.title} image gallery`} />
  <Footer />
</BaseLayout>
