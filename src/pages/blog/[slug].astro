---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readingTime = post.data.readingTime ?? 5;
---

<BaseLayout title={`${post.data.title} — Jainavaneeth Kumarashankar`} description={post.data.description} image={post.data.coverImage}>
  <Header />
  <main id="main-content" class="article">
    <article>
      <header>
        <div class="eyebrow">// {post.data.category}</div>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          <span>{readingTime} min read</span>
        </div>
      </header>
      {post.data.coverImage && <img src={post.data.coverImage} alt={post.data.coverAlt ?? `${post.data.title} cover`} style="width:100%;margin-top:24px" />}
      {toc.length > 0 && (
        <nav class="toc" aria-label="Table of contents">
          <strong class="eyebrow">Table of contents</strong>
          <ul>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
        </nav>
      )}
      <Content />
    </article>
  </main>
  <Footer />
</BaseLayout>
