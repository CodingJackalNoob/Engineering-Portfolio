---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import ResponsiveMediaImage from '../../components/ResponsiveMediaImage.astro';
import { render } from 'astro:content';
import { getPublicArticles } from '../../lib/cms/public-content';
import { getGeneratedMediaAssignments } from '../../lib/cms/generated-settings';
import { getMediaFieldAssignments } from '../../lib/cms/media';
import '../../styles/global.css';

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getPublicArticles()).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug ?? post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const readingTime = post.data.readingTime ?? 5;
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const mediaAssignments = await getGeneratedMediaAssignments();
const articleCover = post.data.cmsId ? getMediaFieldAssignments(mediaAssignments, 'article', post.data.cmsId, 'cover')[0] : undefined;
---

<BaseLayout title={post.data.seoTitle ?? `${post.data.title} — Jainavaneeth Kumarashankar`} description={post.data.seoDescription ?? post.data.description} image={post.data.coverImage}>
  <Header />
  <main id="main-content" class="wrap">
    <article>
      <header class="article-hero">
        <div class="eyebrow">// journal / {post.data.category}</div>
        <h1>{post.data.title}</h1>
        <p>{post.data.subtitle ?? post.data.description}</p>
        <div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>{post.data.updatedDate && <span>Updated {dateLabel(post.data.updatedDate)}</span>}<span>{readingTime} min read</span></div>
        <div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        {(articleCover || post.data.coverImage) && <figure class="cover"><button class="cover-image-button" type="button" data-gallery-open data-image-src={articleCover?.media.url ?? post.data.coverImage} data-image-alt={articleCover?.alt || post.data.coverAlt || `${post.data.title} cover`} aria-label={`Expand ${post.data.title} cover image`}>
          {articleCover ? <ResponsiveMediaImage assignment={articleCover} alt={articleCover.alt || post.data.coverAlt || `${post.data.title} cover`} loading="eager" fetchpriority="high" sizes="(max-width: 760px) 100vw, 1180px" /> : <img src={post.data.coverImage} alt={post.data.coverAlt ?? `${post.data.title} cover`} fetchpriority="high" />}
        </button></figure>}
      </header>
      <div class="article">
        {toc.length > 0 && <nav class="toc" aria-label="Table of contents"><strong class="eyebrow">In this article</strong><ul>{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
        {post.data.videoEmbed && <div class="video-embed"><iframe src={post.data.videoEmbed} title={`${post.data.title} video`} loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>}
        <Content />
      </div>
    </article>
  </main>
  <ImageLightbox title={`${post.data.title} image`} />
  <Footer />
</BaseLayout>
