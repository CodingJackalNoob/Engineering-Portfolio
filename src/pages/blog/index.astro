---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPublicArticles } from '../../lib/cms/public-content';
import '../../styles/global.css';

export const prerender = true;

const posts = (await getPublicArticles()).filter((post) => !post.data.draft).sort((a, b) => (b.data.updatedDate?.valueOf() ?? b.data.date.valueOf()) - (a.data.updatedDate?.valueOf() ?? a.data.date.valueOf()));
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const categories = ['All', ...Array.from(new Set(posts.map((post) => post.data.category)))];
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Engineering Journal — Jainavaneeth Kumarashankar" description="Technical notes on robotics, mechanical engineering, embedded systems, electronics, and software.">
  <Header />
  <main id="main-content" class="wrap">
    <section class="hero"><div class="eyebrow">// engineering journal</div><h1>Notes from the workbench.</h1><p>Build notes, engineering decisions, experiments, and the details that make systems work.</p></section>
    {featured && <section class="featured-article"><div class="sec-head"><h2>Featured writing</h2><span class="sheet-no">LATEST DISPATCH</span></div><article class="card editorial-card reveal">
      <a class="card-link" href={`/blog/${featured.data.slug ?? featured.id}/`} aria-label={`Read ${featured.data.title}`}>
        <div class="project-media">{featured.data.coverImage ? <img src={featured.data.coverImage} alt={featured.data.coverAlt ?? `${featured.data.title} cover`} /> : <div class="media-fallback" aria-hidden="true">FIELD NOTES</div>}</div>
        <div class="editorial-copy"><div class="card-top"><p class="eyebrow">{featured.data.category}</p><span class="sheet-no">{featured.data.readingTime ? `${featured.data.readingTime} MIN READ` : 'ARTICLE'}</span></div><h3>{featured.data.title} <span aria-hidden="true">↗</span></h3><p>{featured.data.description}</p><div class="article-meta"><time datetime={featured.data.date.toISOString()}>{dateLabel(featured.data.date)}</time>{featured.data.updatedDate && <span>Updated {dateLabel(featured.data.updatedDate)}</span>}</div><div class="tags">{featured.data.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}</div></div>
      </a>
    </article></section>}
    <section>
      <div class="sec-head"><h2>All articles</h2><span class="sheet-no">{posts.length.toString().padStart(2, '0')} ENTRIES</span></div>
      <div class="journal-tools"><label class="search-label" for="post-search">Search the journal</label><input class="search" id="post-search" type="search" placeholder="Title, topic, or tag" aria-label="Search articles" /></div>
      {posts.length > 0 && <div class="filters" aria-label="Filter articles by category">{categories.map((category, index) => <button class:list={['filter-button', { active: index === 0 }]} data-blog-filter={category} aria-pressed={index === 0 ? 'true' : 'false'} type="button">{category}</button>)}</div>}
      {posts.length ? <div class="grid" id="blog-grid">
        {posts.map((post) => <article class="card editorial-card reveal" data-category={post.data.category} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
          <a class="card-link" href={`/blog/${post.data.slug ?? post.id}/`} aria-label={`Read ${post.data.title}`}>
            <div class="project-media">{post.data.coverImage ? <img src={post.data.coverImage} alt={post.data.coverAlt ?? `${post.data.title} cover`} loading="lazy" /> : <div class="media-fallback" aria-hidden="true">FIELD NOTES</div>}</div>
            <div class="editorial-copy"><div class="card-top"><p class="eyebrow">{post.data.category}</p><span class="sheet-no">{post.data.readingTime ? `${post.data.readingTime} MIN READ` : 'ARTICLE'}</span></div><h3>{post.data.title} <span aria-hidden="true">↗</span></h3><p>{post.data.description}</p><div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>{post.data.updatedDate && <span>Updated {dateLabel(post.data.updatedDate)}</span>}</div><div class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div>
          </a>
        </article>)}
      </div> : <div class="empty">No published articles yet. New field notes will appear here as they are ready.</div>}
      {posts.length > 0 && <p class="archive-note">ARCHIVE · {Array.from(new Set(posts.map((post) => post.data.date.getFullYear()))).sort((a,b) => b-a).join(' · ')}</p>}
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category][data-search]');
  const search = document.querySelector<HTMLInputElement>('#post-search');
  let activeCategory = 'All';
  function updatePosts() {
    const query = search?.value.trim().toLowerCase() ?? '';
    cards.forEach((card) => { card.hidden = !((activeCategory === 'All' || card.dataset.category === activeCategory) && (!query || card.dataset.search?.includes(query))); });
  }
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    filterButtons.forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); });
    button.classList.add('active'); button.setAttribute('aria-pressed', 'true'); activeCategory = button.dataset.blogFilter ?? 'All'; updatePosts();
  }));
  search?.addEventListener('input', updatePosts);
</script>
