---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import '../styles/global.css';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = projects.filter((project) => project.data.featured);
const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Jainavaneeth Kumarashankar — Engineering Portfolio" description="Mechanical engineering, robotics, embedded systems, electronics, and software portfolio.">
  <Header />
  <main id="main-content" class="wrap home-page">
    <section class="hero">
      <div class="hero-mark" aria-hidden="true">FIELD NOTES / 01<br />MECHANICAL SYSTEMS<br />SIGNAL + MOTION</div>
      <div class="eyebrow">// engineering portfolio &amp; build log</div>
      <h1>I design, build, and document hardware that moves.</h1>
      <p>I am Jainavaneeth Kumarashankar, an engineer focused on robotics, mechanical design, embedded systems, electronics, and software.</p>
      <div class="button-row">
        <a class="button primary" href="/projects/">Explore projects <span aria-hidden="true">↗</span></a>
        <a class="button" href="/blog/">Read the blog</a>
        <a class="button quiet" href="/contact/">Contact</a>
      </div>
    </section>

    <section>
      <div class="sec-head"><h2>Selected work</h2><a class="sheet-no" href="/projects/">VIEW ALL / PROJECTS ↗</a></div>
      {featured.length ? (
        <div class="grid project-grid">
          {featured.map((project) => (
            <article class="card project-card reveal">
              <a class="card-link" href={`/projects/${project.data.slug ?? project.id}/`} aria-label={`View ${project.data.title} project`}>
                <div class="project-media">
                  {project.data.coverImage ? <img src={project.data.coverImage} alt={project.data.coverAlt ?? `${project.data.title} project`} loading="lazy" /> : <div class="media-fallback" aria-hidden="true">RENDER IN PROGRESS</div>}
                </div>
                <div class="project-copy">
                  <div class="card-top"><p class="eyebrow">{project.data.category}</p><span class:list={['status', project.data.status.toLowerCase().replace(' ', '-')] }>{project.data.status}</span></div>
                  <h3>{project.data.title} <span aria-hidden="true">↗</span></h3>
                  <p>{project.data.description}</p>
                  <div class="tags">{project.data.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : <div class="empty">Project studies are being prepared.</div>}
    </section>

    <section>
      <div class="sec-head"><h2>Recent writing</h2><a class="sheet-no" href="/blog/">OPEN THE JOURNAL ↗</a></div>
      {posts.length ? (
        <div class="grid">
          {posts.slice(0, 3).map((post) => (
            <article class="card editorial-card reveal">
              <a class="card-link" href={`/blog/${post.data.slug ?? post.id}/`} aria-label={`Read ${post.data.title}`}>
                <div class="project-media">{post.data.coverImage ? <img src={post.data.coverImage} alt={post.data.coverAlt ?? `${post.data.title} article`} loading="lazy" /> : <div class="media-fallback" aria-hidden="true">FIELD NOTES</div>}</div>
                <div class="editorial-copy">
                  <div class="card-top"><p class="eyebrow">{post.data.category}</p><span class="sheet-no">{post.data.readingTime ? `${post.data.readingTime} MIN READ` : 'ARTICLE'}</span></div>
                  <h3>{post.data.title} <span aria-hidden="true">↗</span></h3>
                  <p>{post.data.description}</p>
                  <div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time></div>
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : <div class="empty">The journal is quiet for now. Project notes will appear here as they are published.</div>}
    </section>

    <section>
      <div class="sec-head"><h2>Areas of exploration</h2><span class="sheet-no">ENGINEERING FOCUS</span></div>
      <div class="tags"><span class="tag">Robotics</span><span class="tag">Mechanical Design</span><span class="tag">Embedded Systems</span><span class="tag">PCB Design</span><span class="tag">Electronics</span><span class="tag">Software</span></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
