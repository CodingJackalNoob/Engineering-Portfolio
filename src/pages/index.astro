---
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGeneratedAbout } from '../lib/cms/generated-settings';
import { getPublicProjects } from '../lib/cms/public-content';
import '../styles/global.css';

export const prerender = true;

const about = await getGeneratedAbout();
const localPortraitPath = path.join(process.cwd(), 'public', 'images', 'about', 'jai-portrait.jpg');
const portraitSrc = about?.profilePhoto || (existsSync(localPortraitPath) ? '/images/about/jai-portrait.jpg' : undefined);
const portraitAlt = about?.profilePhotoAlt || 'Portrait of Jai';
const projects = (await getPublicProjects()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const inProgressProjects = projects.filter((project) => project.data.status === 'In Progress');
const projectCards = (inProgressProjects.length ? inProgressProjects : projects.filter((project) => project.data.featured)).slice(0, 3);

// Add an image under public/images/about and set src to its public URL when one is ready.
const photoSlots = [
  { title: 'Robotics days', filename: 'robotics-competition.jpg', src: '', alt: '' },
  { title: 'At the workbench', filename: 'workbench.jpg', src: '', alt: '' },
  { title: 'Things in progress', filename: 'design-process.jpg', src: '', alt: '' },
  { title: 'Team moments', filename: 'team-and-outreach.jpg', src: '', alt: '' },
  { title: 'The little details', filename: 'everyday-moments.jpg', src: '', alt: '' },
];
---

<BaseLayout title="Jainavaneeth Kumarashankar — Engineering Portfolio" description="A personal engineering portfolio by Jainavaneeth Kumarashankar, exploring robotics, mechanical design, embedded systems, electronics, and software.">
  <Header />
  <main id="main-content" class="wrap home-page">
    <section class="home-hero">
      <div class="home-hero-copy">
        <div class="eyebrow">// curious by design · learning by building</div>
        <p class="home-name">Jainavaneeth Kumarashankar <span>ASPIRING ENGINEER</span></p>
        <h1>How does it work?<br /><em>Let’s find out.</em></h1>
        <p class="home-intro">I’m drawn to the moment an idea starts taking shape: a mechanism on the bench, a circuit on the board, a few lines of code making something move. I’m an aspiring engineer exploring robotics, mechanical design, embedded systems, electronics, and software—one experiment at a time.</p>
        <nav class="home-actions" aria-label="Explore the portfolio">
          <a class="button primary" data-magnetic href="/projects/">Explore projects <span aria-hidden="true">↗</span></a>
          <a class="button" data-magnetic href="/blog/">Engineering journal <span aria-hidden="true">↗</span></a>
          <a class="home-about-link" href="/about/">A little about me <span aria-hidden="true">→</span></a>
        </nav>
        <nav class="home-contact-links" aria-label="Contact and profile links">
          <span class="home-contact-label">FIND ME</span>
          <a href="https://docs.google.com/document/d/15bTIqRBPBd6BytwSrfBseb7gckVknX4qZqFh-7cwzYg/edit?tab=t.0" target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
          <a href="https://github.com/CodingJackalNoob" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="mailto:jainavaneeth@gmail.com">Email <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <figure class="home-hero-visual">
        {portraitSrc
          ? <img src={portraitSrc} alt={portraitAlt} fetchpriority="high" />
          : <div class="home-portrait-placeholder" role="img" aria-label="Portrait placeholder. Add jai-portrait.jpg to public/images/about."><span>JK</span></div>}
        <figcaption class="home-portrait-caption">
          <span class="eyebrow">HELLO THERE</span>
          <strong>I’m Jai<span aria-hidden="true">.</span></strong>
        </figcaption>
      </figure>
      <div class="hero-bottom-note"><span>AN OPEN NOTEBOOK, NOT A FINISHED BLUEPRINT</span><span aria-hidden="true">SCROLL TO EXPLORE ↓</span></div>
    </section>
    <div class="home-photo-strip" aria-label="Personal photo collection">
      <div class="photo-strip-heading">
        <div>
          <span class="eyebrow">// LITTLE MOMENTS, BIG BUILDS</span>
          <p>Your photos go here. Add images to <code>public/images/about/</code>.</p>
        </div>
        <button class="photo-motion-toggle" type="button" aria-pressed="false" aria-controls="photo-track" data-photo-motion-toggle>Pause photos</button>
      </div>
      <div class="photo-marquee">
        <div class="photo-track" id="photo-track">
          {[false, true].map((duplicate) => (
            <div class="photo-group" aria-hidden={duplicate ? 'true' : undefined}>
              {photoSlots.map((photo, index) => (
                <figure class="photo-card reveal">
                  {photo.src ? (
                    <img src={photo.src} alt={photo.alt} loading="lazy" />
                  ) : (
                    <div class="photo-placeholder" role="img" aria-label={`Photo placeholder: ${photo.title}`}>
                      <span class="placeholder-index">SNAPSHOT / {String(index + 1).padStart(2, '0')}</span>
                      <span class="placeholder-cross" aria-hidden="true">+</span>
                      <span class="placeholder-add">ADD YOUR PHOTO</span>
                      <span class="placeholder-file">{photo.filename}</span>
                    </div>
                  )}
                  <figcaption><strong>{photo.title}</strong></figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
    <section class="home-projects-section" aria-labelledby="home-projects-title">
      <div class="home-projects-heading">
        <div>
          <p class="eyebrow">// FROM SNAPSHOTS TO SYSTEMS</p>
          <h2 id="home-projects-title">Projects from the workbench.</h2>
        </div>
        <a class="text-link" href="/projects/">Browse all projects <span aria-hidden="true">↗</span></a>
      </div>
      {projectCards.length ? (
        <div class="home-project-grid">
          {projectCards.map((project) => {
            const projectImage = project.data.coverImage ?? project.data.images[0]?.src;
            const projectImageAlt = project.data.coverImage
              ? project.data.coverAlt ?? `${project.data.title} project`
              : project.data.images[0]?.alt ?? `${project.data.title} project`;
            return (
              <article class="card project-card home-project-card reveal" data-tilt-card>
                <a class="card-link" href={`/projects/${project.data.slug ?? project.id}/`} aria-label={`View ${project.data.title} project`}>
                  <div class="project-media">
                    {projectImage
                      ? <img src={projectImage} alt={projectImageAlt} loading="lazy" />
                      : <div class="media-fallback project-image-placeholder" aria-hidden="true">PROJECT PHOTO SLOT</div>}
                  </div>
                  <div class="project-copy">
                    <div class="card-top">
                      <p class="eyebrow">{project.data.category}</p>
                      <span class:list={['status', project.data.status.toLowerCase().replace(' ', '-')] }>{project.data.status}</span>
                    </div>
                    <h3>{project.data.title} <span aria-hidden="true">↗</span></h3>
                    <p>{project.data.description}</p>
                    <div class="tags">{project.data.technologies.map((technology) => <span class="tag">{technology}</span>)}</div>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      ) : <div class="empty">Project notes are on the way.</div>}
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-photo-motion-toggle]');
    const track = document.querySelector<HTMLElement>('#photo-track');
    if (!button || !track) return;

    const paused = track.classList.toggle('is-paused');
    button.setAttribute('aria-pressed', String(paused));
    button.textContent = paused ? 'Resume photos' : 'Pause photos';
  });
</script>
