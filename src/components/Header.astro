---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="titleblock">
  <div class="tb-row">
    <a class="tb-name" href="/" aria-label="Jainavaneeth Kumarashankar home">
      Jainavaneeth Kumarashankar
      <span>MECHANICAL + EMBEDDED SYSTEMS</span>
    </a>
    <nav aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
