---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="nav-shell">
    <a class="brand" href="/" aria-label="Jainavaneeth Kumarashankar home">
      <span class="brand-name">Jainavaneeth Kumarashankar</span>
      <span class="brand-caption">MECHANICAL + EMBEDDED SYSTEMS</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="menu-icon" aria-hidden="true"></span><span class="menu-label">Menu</span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const updateHeader = () => document.querySelector('.site-header')?.classList.toggle('is-scrolled', window.scrollY > 12);
  document.addEventListener('astro:page-load', updateHeader);
  window.addEventListener('scroll', updateHeader, { passive: true });
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const toggle = event.target.closest<HTMLButtonElement>('.menu-toggle');
    const nav = document.querySelector<HTMLElement>('#primary-nav');
    if (toggle) {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('is-open', !open);
      return;
    }
    if (event.target.closest('#primary-nav a')) {
      document.querySelector<HTMLButtonElement>('.menu-toggle')?.setAttribute('aria-expanded', 'false');
      nav?.classList.remove('is-open');
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    document.querySelector('#primary-nav')?.classList.remove('is-open');
    toggle.focus();
  });
</script>
